# Copia este archivo a .env. Los valores son solo para desarrollo local.
POSTGRES_DB=pawconnect
POSTGRES_USER=pawconnect
POSTGRES_PASSWORD=pawconnect

S3_BUCKET=pawconnect-recortes
S3_ACCESS_KEY=pawconnect
S3_SECRET_KEY=pawconnect-secreto

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-solo-local-no-usar-en-produccion

# Para correr la API fuera de Docker (uv run python manage.py runserver):
# DATABASE_URL=postgres://pawconnect:pawconnect@localhost:5432/pawconnect
# RECONOCIMIENTO_URL=http://localhost:8001
# S3_ENDPOINT_URL=http://localhost:9000
